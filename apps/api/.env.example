NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL="mysql://booking:bookingpassword@localhost:3306/service_efficiency"
# DATABASE_URL="mysql://service_efficiency:REPLACE_WITH_MYSQL_PASSWORD@127.0.0.1:3307/service_efficiency"

# Daily import of Branches and Staff from the ERP (D53/D54). Leave unset to switch it off.
# Never put real values in git: set them in the Coolify environment of the `api` app.
# ERP_ODATA_BASE_URL=https://pos.uficon.net/fmi/odata/v4/UFService
# ERP_ODATA_USER=
# ERP_ODATA_PASS=
# Bangkok times, comma separated. Empty = no schedule (ADMIN "run now" only).
# ERP_SYNC_TIMES=10:00
# ERP_SYNC_CATCHUP_MIN=60

# Products and stock from the warroom database (D52). Leave WARROOM_DATABASE_URL unset to switch it off.
# Use a READ-ONLY role (warroom's npi_reader works); set it in the Coolify environment, never in git.
# WARROOM_DATABASE_URL=postgres://<user>:<password>@<warroom-db-host>:5432/Dashboard_NPI_Warroom
# off | shadow (default: stores ERP numbers, staff still see the manual stock, no catalog changes) | on
# WARROOM_STOCK_MODE=shadow
# Minutes between checks for a newer warroom snapshot (warroom itself refreshes 5 times a day). 0 = manual runs only.
# WARROOM_SYNC_MINUTES=10

# U POS integration (D60). Leave unset to switch it off (the /api/integrations/pos routes then answer 404).
# A random string of 32 or more characters (openssl rand -hex 32); the same value goes into U POS. Set it in the Coolify environment, never in git.
# POS_API_KEY=
