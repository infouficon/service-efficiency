generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  MANAGER
  STAFF
  STOCK
  CASHIER
}

enum WorkflowState {
  WALK_IN
  DEMO
  DECISION
  PRODUCT_SELECTION
  STOCK_REQUESTED
  SEARCHING
  FOUND
  SENT_TO_CASHIER
  CASHIER_RECEIVED
  CASHIER_SCAN
  BILL_OPENED
  COMPLETED
}

enum Outcome {
  NOT_BUY
  OUT_OF_STOCK
  CUSTOMER_CANCELLED
}

enum EventType {
  SESSION_CREATED
  DEMO_STARTED
  DEMO_ENDED
  DECISION_MADE
  PRODUCT_SELECTION_STARTED
  PRODUCT_SELECTION_CONFIRMED
  STOCK_SEARCHING
  STOCK_FOUND
  STOCK_SENT_TO_CASHIER
  STOCK_OUT_OF_STOCK
  CUSTOMER_CANCELLED
  STOCK_REPORTED_MISSING
  STAFF_RESOLVED_STOCK_REVIEW
  CASHIER_RECEIVED
  CASHIER_SCANNED
  BILL_OPENED
  COMPLETED
  CASHIER_REJECTED
  STOCK_ACKNOWLEDGED_CANCEL
}

model Branch {
  id       String            @id @default(uuid()) @db.VarChar(36)
  code     String            @db.VarChar(64)
  name     String            @db.VarChar(191)
  phone    String            @db.VarChar(64)
  active   Boolean           @default(true)
  // ERP branch_id when the row is kept in sync with the ERP (D53); null for hand-made branches
  erpBranchId Int?           @unique
  // F10: the address the receipt's QR code opens (customer registration), one per branch; set by ADMIN, also on ERP branches
  registrationUrl String?    @db.VarChar(512)
  staff    Staff[]
  sessions CustomerSession[]
  inventory BranchInventory[]
}

model Staff {
  staffId            String            @id @db.VarChar(64)
  firstName          String            @default("") @db.VarChar(100)
  lastName           String            @default("") @db.VarChar(100)
  passwordHash       String            @db.VarChar(255)
  branchId           String?           @db.VarChar(36)
  branch             Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  active             Boolean           @default(true)
  mustChangePassword Boolean           @default(true)
  failedAttempts     Int               @default(0)
  lockedUntil        DateTime?         @db.DateTime(3)
  // ERP staff_id when the account is created and kept in sync by the ERP import (D54); null for hand-made accounts
  erpStaffId         Int?              @unique
  erpSyncedAt        DateTime?         @db.DateTime(3)
  roles              StaffRole[]
  sessions           LoginSession[]
  customerSessions   CustomerSession[]
}

model Role {
  code  RoleCode    @id
  staff StaffRole[]
}

model StaffRole {
  staffId  String   @db.VarChar(64)
  roleCode RoleCode
  staff    Staff    @relation(fields: [staffId], references: [staffId], onDelete: Restrict)
  role     Role     @relation(fields: [roleCode], references: [code], onDelete: Restrict)

  @@id([staffId, roleCode])
}

model LoginSession {
  tokenHash  String   @id @db.Char(64)
  staffId    String   @db.VarChar(64)
  staff      Staff    @relation(fields: [staffId], references: [staffId], onDelete: Cascade)
  lastSeenAt DateTime @db.DateTime(3)

  @@index([staffId])
  @@index([lastSeenAt])
}

// Technical mutex: serializes security-sensitive updates, including last-admin checks.
model AccountLock {
  id Int @id
}

model Customer {
  id        String            @id @default(uuid()) @db.VarChar(36)
  phone     String            @unique @db.VarChar(10)
  createdAt DateTime          @default(now()) @db.DateTime(3)
  sessions  CustomerSession[]
}

// D57, D69: back-office list of customer types. The letter (A-Z, unique) is the queue letter and the sort order.
// D57, D69, D70: back-office list of customer types. The letter (A-Z, unique) is the queue letter and the sort order.
// Criteria (paymentMethods, ontop, points, burnPoints) auto-classify sessions to this customer type upon confirmation (D70).
model CustomerType {
  id             String            @id @default(uuid()) @db.VarChar(36)
  letter         String            @unique @db.VarChar(1)
  name           String            @db.VarChar(64)
  description    String?           @db.VarChar(191)
  active         Boolean           @default(true)
  paymentMethods Json?
  ontop          Json?
  points         Json?
  burnPoints     Json?
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @db.DateTime(3)
  sessions       CustomerSession[]
}

// D59: global switches set by ADMIN (today only `stockUnlimited`). The value is text so it reads the same on MySQL and MariaDB.
model Setting {
  name      String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  updatedBy String?  @db.VarChar(64)
}

// F6: the payment methods staff can pick on a session, kept by ADMIN. The name is the value stored on a session's payments
// (history), so a method is switched off, never renamed or deleted. `position` is the order shown.
model PaymentMethod {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @unique @db.VarChar(64)
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.DateTime(3)
}

// Atomic running numbers that restart every Asia/Bangkok day: scope `reference` (SES-YYYYMMDD-NNNNNN) and
// `queue:<branchId>:<letter>` (D57). Incremented with INSERT ... ON DUPLICATE KEY UPDATE inside the caller's transaction.
model DailyCounter {
  scope   String @db.VarChar(80)
  day     String @db.VarChar(10)
  lastNo  Int

  @@id([scope, day])
}

/**
 * D68: the product categories, kept by ADMIN and created by the warroom sync (switched OFF until ADMIN opens them).
 * `Product.category` stores the name. Staff only see products of an active category.
 */
model Category {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @unique @db.VarChar(100)
  active     Boolean  @default(true)
  position   Int      @default(0)
  // accessory-like (warroom "Apple Accy", "Third Party Accy"): not offered as a main product in the picker
  isAccessory Boolean @default(false)
  // created by the warroom sync (not by hand or the migration)
  erpManaged Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.DateTime(3)
}

model Product {
  id        String            @id @default(uuid()) @db.VarChar(36)
  // D68: the name of a Category row (what warroom calls it, or one of the five Apple lines); a plain string so new
  // categories need no deploy. Names are never renamed, so this stays valid.
  category  String            @db.VarChar(100)
  name      String            @db.VarChar(191)
  active    Boolean           @default(true)
  // created and kept in sync from the warroom database (D52); names are then read-only in SES
  erpManaged Boolean          @default(false)
  models    ProductModel[]
  sessions  CustomerSession[]

  @@index([category])
}

model ProductModel {
  id        String            @id @default(uuid()) @db.VarChar(36)
  productId String            @db.VarChar(36)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  name      String            @db.VarChar(191)
  active    Boolean           @default(true)
  erpManaged Boolean          @default(false)
  skus      ProductSku[]
  sessions  CustomerSession[]

  @@index([productId])
}

model ProductSku {
  id        String            @id @default(uuid()) @db.VarChar(36)
  modelId   String            @db.VarChar(36)
  model     ProductModel      @relation(fields: [modelId], references: [id], onDelete: Restrict)
  sku       String            @unique @db.VarChar(64)
  name      String            @db.VarChar(191)
  color     String?           @db.VarChar(64)
  storage   String?           @db.VarChar(64)
  // barcode (warroom product_upc) next to the part number kept in `sku` (D68)
  upc       String?           @db.VarChar(64)
  active    Boolean           @default(true)
  erpManaged Boolean          @default(false)
  sessions  CustomerSession[]
  inventory BranchInventory[]
  sessionItems SessionItem[]

  @@index([modelId])
}

model BranchInventory {
  id        String     @id @default(uuid()) @db.VarChar(36)
  branchId  String     @db.VarChar(36)
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  skuId     String     @db.VarChar(36)
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  stock     Int        @default(0)
  active    Boolean    @default(true)
  // numbers from the warroom snapshot taken at erpAsOf (D52); null = no ERP data, the manual `stock` applies
  erpReady     Int?
  erpTransfer  Int?
  erpAsOf      DateTime? @db.DateTime(3)
  // D41 "reported missing / out of stock" at the branch: counts as 0 until a newer ERP snapshot
  outOfStockAt DateTime? @db.DateTime(3)
  createdAt DateTime   @default(now()) @db.DateTime(3)
  updatedAt DateTime   @updatedAt @db.DateTime(3)

  @@unique([branchId, skuId])
  @@index([branchId])
  @@index([skuId])
}

model CustomerSession {
  id         String        @id @default(uuid()) @db.VarChar(36)
  reference  String        @unique @db.VarChar(32)
  branchId   String        @db.VarChar(36)
  branch     Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staffId    String        @db.VarChar(64)
  staff      Staff         @relation(fields: [staffId], references: [staffId], onDelete: Restrict)
  customerId String?       @db.VarChar(36)
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  phone      String?       @db.VarChar(10)
  state      WorkflowState @default(WALK_IN)
  confirmed  Boolean       @default(false)
  outcome    Outcome?
  reason     String?       @db.VarChar(191)
  otherReason String?      @db.Text
  cancelledBy String?      @db.VarChar(64)
  stockReview Json?
  // D57: the type chosen at the phone step and the queue number it produced ("A012"); the letter is frozen here so
  // renaming or re-lettering a type never rewrites history. Null on sessions created before D57 (queueNo then holds
  // the old per-day running number).
  customerTypeId String?       @db.VarChar(36)
  customerType   CustomerType? @relation(fields: [customerTypeId], references: [id], onDelete: Restrict)
  queueLetter    String?       @db.VarChar(1)
  queueNo        Int?
  // F12: the stock side of a cancel. Null while stock still has to act (bring the goods back, stop searching).
  stockAckAt     DateTime?     @db.DateTime(3)
  stockAckBy     String?       @db.VarChar(64)
  // F11: the cancelled session this one was opened from with "buy again" (it keeps the queue number); once per session
  // F17 (D60): the bill U POS opened for this order, reported by U POS: its number and the real time it was opened
  posBillNo       String?       @db.VarChar(64)
  posBillOpenedAt DateTime?     @db.DateTime(3)
  rebuyOfId      String?       @unique @db.VarChar(36)
  rebuyOf        CustomerSession? @relation("Rebuy", fields: [rebuyOfId], references: [id], onDelete: SetNull)
  rebuiltAs      CustomerSession? @relation("Rebuy")

  // F3: the main products of a session are `items` (SKU + quantity). These three columns are the old single main
  // product: kept for sessions from before F3 (the migration copied each into an item) and never written any more.
  productId  String?       @db.VarChar(36)
  product    Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  modelId    String?       @db.VarChar(36)
  model      ProductModel? @relation(fields: [modelId], references: [id], onDelete: Restrict)
  skuId      String?       @db.VarChar(36)
  sku        ProductSku?   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  customerWalkInAt            DateTime  @default(now()) @db.DateTime(3)
  demoStartAt                 DateTime? @db.DateTime(3)
  demoEndAt                   DateTime? @db.DateTime(3)
  decisionAt                  DateTime? @db.DateTime(3)
  productSelectionStartAt     DateTime? @db.DateTime(3)
  productSelectionConfirmedAt DateTime? @db.DateTime(3)
  stockStartedAt              DateTime? @db.DateTime(3)
  stockFoundAt                DateTime? @db.DateTime(3)
  cashierReceivedAt           DateTime? @db.DateTime(3)
  cashierScanAt               DateTime? @db.DateTime(3)
  billOpenedAt                DateTime? @db.DateTime(3)
  cancelledAt                 DateTime? @db.DateTime(3)

  items       SessionItem[]
  accessories SessionAccessory[]
  ontop       SessionOntop[]
  points      SessionPoint[]
  burnPoints  SessionBurnPoint[]
  payments    SessionPayment[]
  events      SessionEvent[]

  @@index([branchId])
  @@index([staffId])
  @@index([state])
  @@index([customerWalkInAt])
}

// F3: one main product of a Customer Session: a SKU and how many. `deducted` = the units FOUND really took off the
// branch shelf (0 while "stock unlimited" is on, D59); a cancel gives back exactly these.
model SessionItem {
  id        String          @id @default(uuid()) @db.VarChar(36)
  sessionId String          @db.VarChar(36)
  session   CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skuId     String          @db.VarChar(36)
  sku       ProductSku      @relation(fields: [skuId], references: [id], onDelete: Restrict)
  quantity  Int             @default(1)
  deducted  Int             @default(0)
  createdAt DateTime        @default(now()) @db.DateTime(3)

  @@index([sessionId])
  @@index([skuId])
}

model SessionAccessory {
  id            String          @id @default(uuid()) @db.VarChar(36)
  sessionId     String          @db.VarChar(36)
  session       CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  accessoryName String          @db.VarChar(64)
  quantity      Int             @default(1)

  @@index([sessionId])
}

model SessionOntop {
  id        String          @id @default(uuid()) @db.VarChar(36)
  sessionId String          @db.VarChar(36)
  session   CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String          @db.VarChar(64)

  @@index([sessionId])
}

model SessionPoint {
  id        String          @id @default(uuid()) @db.VarChar(36)
  sessionId String          @db.VarChar(36)
  session   CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String          @db.VarChar(64)

  @@index([sessionId])
}

model SessionBurnPoint {
  id        String          @id @default(uuid()) @db.VarChar(36)
  sessionId String          @db.VarChar(36)
  session   CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String          @db.VarChar(64)

  @@index([sessionId])
}

model SessionPayment {
  id        String          @id @default(uuid()) @db.VarChar(36)
  sessionId String          @db.VarChar(36)
  session   CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  method    String          @db.VarChar(64)

  @@index([sessionId])
}

model SessionEvent {
  id           String          @id @default(uuid()) @db.VarChar(36)
  sessionId    String          @db.VarChar(36)
  session      CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType    EventType
  actorStaffId String          @db.VarChar(64)
  createdAt    DateTime        @default(now()) @db.DateTime(3)
  metadata     Json?

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
}

// One row per ERP import run (D53/D54). `slot` makes a scheduled run claimable once per time slot across containers.
model ErpSyncRun {
  id           String    @id @default(uuid()) @db.VarChar(36)
  kind         String    @db.VarChar(32)
  slot         String    @db.VarChar(40)
  trigger      String    @db.VarChar(16)
  dryRun       Boolean   @default(false)
  attempts     Int       @default(1)
  startedAt    DateTime  @default(now()) @db.DateTime(3)
  finishedAt   DateTime? @db.DateTime(3)
  ok           Boolean?
  summary      Json?
  error        String?   @db.Text
  actorStaffId String?   @db.VarChar(64)

  @@unique([kind, slot])
  @@index([startedAt])
}
